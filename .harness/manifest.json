      "triggerPaths": [
        "app/logic/play/playerFacingCopy.ts",
        "app/logic/play/playCompliance.spec.ts",
        "app/logic/play/workFlow.ts",
        "app/logic/play/archiveDisplay.ts",
        "app/logic/act1/profileTagLabels.ts",
        "app/components/play/**",
        "app/pages/play/**",
        "app/composables/usePlay*.ts"
      ]
    },
    {
      "id": "player-facing-copy-static",
      "spec": "app/logic/play/playCompliance.spec.ts",
      "doc": "AGENTS.md#玩家可见文案禁止英文内部标签",
      "triggerPaths": [
        "app/logic/play/**",
        "app/components/play/**",
        "app/pages/play/**",
        "app/composables/usePlay*.ts"
      ]
    },
    {
      "id": "pressure-offer-integrity",
      "spec": [
        "app/logic/play/pressureOfferIntegrity.spec.ts",
        "app/logic/play/playCompliance.spec.ts"
      ],
      "doc": "AGENTS.md#压力牌四选二-offered-须-4-个不同-id",
      "triggerPaths": [
        "app/logic/play/pressureDeck.ts",
        "app/logic/play/playDayCycle.ts",
        "app/logic/gameDayCycle.ts",
        "app/logic/play/pressureOfferIntegrity.ts",
        "app/logic/play/setpieceFlow.ts",
        "app/components/play/PressureDeck.vue",
        "app/logic/play/playCompliance.spec.ts"
      ]
    },
    {
      "id": "m4-body-mortgage",
      "spec": "app/logic/play/bodyMortgage.spec.ts",
      "doc": "docs/planning/M4-body-endings/PLAN.md",
      "triggerPaths": [
