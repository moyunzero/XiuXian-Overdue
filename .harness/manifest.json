        "app/logic/play/playDayCycle.spec.ts"
      ],
      "doc": "docs/harness-engineering.md",
      "triggerPaths": [
        "app/logic/play/setpieceFlow.ts",
        "app/composables/usePlayHsSession.ts",
        "app/composables/usePlayUniSession.ts",
        "app/logic/play/pressureDeck.ts",
        "app/logic/play/playDayCycle.ts",
        "app/logic/gameDayCycle.ts",
        "app/logic/play/pressureOfferIntegrity.ts",
        "app/components/play/PressureDeck.vue"
      ]
    },
    {
      "id": "validate:realm-templates",
      "title": "realmTemplates / collapseEndings 结构校验",
      "command": "yarn validate:realm-templates",
      "required": true,
      "triggerPaths": [
        "data/realmTemplates.json",
        "data/collapseEndings.json",
        "scripts/validate-realm-templates.mjs",
        "scripts/schemas/realmTemplates.schema.ts",
        "scripts/schemas/format-zod-errors.ts",
        "scripts/schemas/load-schema.mjs",
        "scripts/schemas/validate-with-zod.mjs"
      ]
    },
    {
      "id": "validate:chapters",
      "title": "chapters/*.json 结构校验",
      "command": "yarn validate:chapters",
      "required": true,
      "triggerPaths": [
        "data/chapters/**",
        "scripts/validate-chapters.mjs"
      ]
    },
    {
      "id": "validate:mandates",
      "title": "mandates/*.json 结构校验",
      "command": "yarn validate:mandates",
      "required": true,
      "triggerPaths": [
        "data/mandates/**",
        "scripts/validate-mandates.mjs"
      ]
    },
    {
      "id": "m8-meta-ai-flow",
      "spec": [
        "app/logic/play/playMeta.spec.ts",
        "app/logic/play/playAiMoments.spec.ts"
      ],
      "doc": "docs/planning/M8-meta-ai/PLAN.md",
      "triggerPaths": [
        "app/logic/play/playMeta.ts",
        "app/logic/play/playAiMoments.ts",
        "app/logic/act1/act1Carryover.ts",
        "app/logic/act1/metaUnlockLabels.ts",
