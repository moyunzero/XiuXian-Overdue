{
  "$schema": "./manifest.schema.json",
  "version": 1,
  "description": "Machine-readable verification gates for AI agents and CI. Run via: yarn harness:verify",
  "pev": {
    "planArtifact": ".harness/PEV.md",
    "progressArtifact": ".harness/progress.md"
  },
  "gates": [
    {
      "id": "architecture",
      "title": "分层与依赖边界",
      "command": "node scripts/harness/architecture-check.mjs",
      "required": true,
      "triggerPaths": [
        "app/logic/**",
        "app/composables/**",
        "app/pages/**",
        "app/components/**",
        "scripts/harness/**"
      ]
    },
    {
      "id": "test",
      "title": "Vitest 全量",
      "command": "yarn test",
      "required": true,
      "triggerPaths": [
        "app/logic/**",
        "app/composables/**",
        "vitest.config.ts"
      ],
      "excludeFromQuick": false
    },
    {
      "id": "test:act1",
      "title": "Act1 逻辑回归（含防卡点）",
      "command": "yarn test:act1",
      "required": true,
      "triggerPaths": [
        "app/logic/act1/**",
        "app/components/act1/**",
        "app/composables/useAct1Session.ts",
        "app/pages/act1/**",
        "app/types/act1.ts"
      ]
    },
    {
      "id": "validate:events",
      "title": "events.json 结构校验",
      "command": "yarn validate:events",
      "required": true,
      "triggerPaths": [
        "data/events.json",
        "data/eventTemplates.json",
        "scripts/validate-events.mjs"
      ]
    },
    {
      "id": "validate:pressure-cards",
      "title": "pressureCards.json 结构校验",
      "command": "yarn validate:pressure-cards",
      "required": true,
      "triggerPaths": [
        "data/pressureCards.json",
        "scripts/validate-pressure-cards.mjs",
        "scripts/schemas/pressureCards.schema.ts",
        "scripts/schemas/format-zod-errors.ts",
        "scripts/schemas/load-schema.mjs",
        "scripts/schemas/validate-with-zod.mjs"
      ]
    },
    {
      "id": "validate:inbox-templates",
      "title": "inboxTemplates.json 结构校验",
      "command": "yarn validate:inbox-templates",
      "required": true,
      "triggerPaths": [
        "data/inboxTemplates.json",
        "scripts/validate-inbox-templates.mjs"
      ]
    },
    {
      "id": "validate:jobs",
      "title": "jobs.json 结构校验",
      "command": "yarn validate:jobs",
      "required": true,
      "triggerPaths": [
        "data/jobs.json",
        "scripts/validate-jobs.mjs"
      ]
    },
    {
      "id": "test:storage",
      "title": "存档读写回归",
      "command": "yarn vitest --run app/composables/useGameStorage.spec.ts app/composables/usePlayStorage.spec.ts",
      "required": false,
      "triggerPaths": [
        "app/composables/useGameStorage.ts",
        "app/composables/usePlayStorage.ts",
        "app/composables/usePlayStorage.helpers.ts",
        "app/types/game.ts",
        "app/types/act1.ts",
        "app/types/play.ts"
      ]
    },
    {
      "id": "build",
      "title": "Nuxt 生产构建",
      "command": "yarn build",
      "required": false,
      "slow": true,
      "triggerPaths": [
        "app/**",
        "nuxt.config.ts",
        "package.json"
      ],
      "excludeFromQuick": true
    }
  ],
  "contracts": [
    {
      "id": "act1-family-flow",
      "spec": "app/logic/act1/act1FamilyFlow.spec.ts",
      "doc": "AGENTS.md#act1--家庭账本防卡点契约",
      "triggerPaths": [
        "app/logic/act1/familyLedger.ts",
        "app/components/act1/modules/FamilyModule.vue",
        "app/composables/useAct1Session.ts"
      ]
    },
    {
      "id": "s0-flow",
      "spec": "app/logic/act1/s0Flow.spec.ts",
      "doc": "docs/planning/M3-setpiece-chapters/PLAN.md",
      "triggerPaths": [
        "app/logic/act1/s0Flow.ts",
        "app/components/play/S0SetpieceShell.vue",
        "app/pages/play/index.vue"
      ]
    },
    {
      "id": "m4-run-archive",
      "spec": "app/logic/play/buildRunArchive.spec.ts",
      "doc": "docs/planning/M4-body-endings/PLAN.md",
      "triggerPaths": [
        "app/logic/play/buildRunArchive.ts",
        "app/logic/play/archiveDisplay.ts",
