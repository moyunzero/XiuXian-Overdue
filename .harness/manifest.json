        "app/logic/play/setpieceFlow.ts",
        "app/composables/usePlayEndlessSession.ts",
        "app/components/play/BreakthroughScreen.vue",
        "app/pages/play/index.vue",
        "app/pages/index.vue",
        "data/realmTemplates.json",
        "data/collapseEndings.json",
        "app/types/play.ts"
      ]
    },
    {
      "id": "act1-compliance",
      "spec": "app/logic/act1/act1Compliance.spec.ts",
      "triggerPaths": [
        "app/logic/act1/**",
        "app/components/act1/**"
      ]
    },
    {
      "id": "endless-from-day1-flow",
      "legacy": true,
      "spec": "app/logic/play/endlessFromDay1Flow.spec.ts",
      "doc": "docs/ROADMAP-v3-endless-only.md — legacy：v4 主路径为 chapter 契约，本契约仅回归旧 endless 入口",
      "triggerPaths": [
