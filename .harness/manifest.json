        "app/composables/usePlayStorage.helpers.ts",
        "app/composables/usePlayHsSession.ts",
        "app/composables/usePlayEndlessSession.ts",
        "app/composables/useAct1Session.ts",
        "app/components/play/BreakthroughScreen.vue",
        "app/pages/index.vue",
        "app/pages/play/index.vue",
        "app/types/play.ts",
        "app/types/act1.ts"
      ]
    },
    {
